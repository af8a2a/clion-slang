<idea-plugin>
    <id>dev.shader.slang</id>
    <name>Slang Language Support</name>
    <vendor url="https://github.com/shader-slang/slang">Community</vendor>

    <description><![CDATA[
      Language support for the Slang shading language in CLion. The plugin provides
      built-in lexical highlighting and editor assistance, then connects CLion's native
      LSP client to bundled enhanced <code>slangd</code> (Windows x64) or an external official
      server for diagnostics,
      completion, navigation, semantic highlighting, inlay hints, and formatting.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.ultimate</depends>
    <depends>com.intellij.modules.lsp</depends>
    <depends>com.intellij.modules.clion</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="Slang"
                language="Slang"
                implementationClass="dev.slang.intellij.lang.SlangFileType"
                fieldName="INSTANCE"
                extensions="slang;slangh"/>

        <lang.syntaxHighlighterFactory
                language="Slang"
                implementationClass="dev.slang.intellij.highlighting.SlangSyntaxHighlighterFactory"/>
        <lang.parserDefinition
                language="Slang"
                implementationClass="dev.slang.intellij.lang.SlangParserDefinition"/>
        <colorSettingsPage implementation="dev.slang.intellij.highlighting.SlangColorSettingsPage"/>
        <!-- Only light schemes: Default is also the parent of third-party dark schemes. -->
        <additionalTextAttributes scheme="Light" file="colorSchemes/SlangRiderLight.xml"/>
        <additionalTextAttributes scheme="IntelliJ Light" file="colorSchemes/SlangRiderLight.xml"/>
        <lang.commenter language="Slang" implementationClass="dev.slang.intellij.editor.SlangCommenter"/>
        <lang.braceMatcher language="Slang" implementationClass="dev.slang.intellij.editor.SlangBraceMatcher"/>
        <lang.quoteHandler language="Slang" implementationClass="dev.slang.intellij.editor.SlangQuoteHandler"/>
        <gotoDeclarationHandler implementation="dev.slang.intellij.navigation.SlangGotoDeclarationHandler"/>

        <projectConfigurable
                id="dev.shader.slang.settings"
                parentId="language"
                displayName="Slang"
                instance="dev.slang.intellij.settings.SlangSettingsConfigurable"/>

        <platform.lsp.serverSupportProvider implementation="dev.slang.intellij.lsp.SlangLspServerSupportProvider"/>
        <statusBarWidgetFactory implementation="dev.slang.intellij.preprocessor.SlangContextWidgetFactory"/>
    </extensions>
    <actions>
        <action id="Slang.PreviewPreprocessorBranch" class="dev.slang.intellij.preprocessor.SlangPreviewBranchAction"
                text="Slang Branch Preview…" description="Temporarily define or undefine macros for branch display (M4d slangd)">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="Slang.StopPreprocessorPreview" class="dev.slang.intellij.preprocessor.SlangStopBranchPreviewAction"
                text="Stop Slang Branch Preview" description="Remove temporary overrides and restore the selected context or Shader Variant">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="Slang.SelectPreprocessorContext" class="dev.slang.intellij.preprocessor.SlangSelectContextAction"
                text="Slang Preprocessor Context…" description="Choose the compilation root for Slang branch display">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
