+// HLSL SM 6.6 compatibility for the bundled language server. Keep descriptor
+// kinds in the type system, so sampler and resource heaps cannot be interchanged.
+struct __HLSLDescriptorHeapElement<let kind : __DynamicResourceKind>
+{
+    uint index;
+}
+struct __HLSLDescriptorHeap<let kind : __DynamicResourceKind>
+{
+    __subscript(uint index) -> __HLSLDescriptorHeapElement<kind>
+    {
+        get { return { index }; }
+    }
+}
+static const __HLSLDescriptorHeap<__DynamicResourceKind.General> ResourceDescriptorHeap = {};
+static const __HLSLDescriptorHeap<__DynamicResourceKind.Sampler> SamplerDescriptorHeap = {};
