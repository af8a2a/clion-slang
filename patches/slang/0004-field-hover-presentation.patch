     return false;
 }
 
+static bool _tryAppendStructFieldHoverSignature(
+    StringBuilder& sb,
+    DeclRef<Decl> declRef,
+    ASTBuilder* astBuilder)
+{
+    auto fieldDeclRef = declRef.as<VarDecl>();
+    if (!fieldDeclRef || !fieldDeclRef.getName())
+        return false;
+
+    auto parentDeclRef = fieldDeclRef.getParent();
+    if (auto genericDeclRef = parentDeclRef.as<GenericDecl>())
+        parentDeclRef = genericDeclRef.getParent();
+    auto structDeclRef = parentDeclRef.as<StructDecl>();
+    if (!structDeclRef)
+        return false;
+
+    auto fieldType = getType(astBuilder, fieldDeclRef);
+    if (!fieldType)
+        return false;
+
+    ASTPrinter printer(
+        astBuilder,
+        ASTPrinter::OptionFlag::NoInternalKeywords |
+            ASTPrinter::OptionFlag::SimplifiedBuiltinType);
+    auto& signature = printer.getStringBuilder();
+    switch (getDeclVisibility(fieldDeclRef.getDecl()))
+    {
+    case DeclVisibility::Public:
+        signature << "public ";
+        break;
+    case DeclVisibility::Internal:
+        signature << "internal ";
+        break;
+    case DeclVisibility::Private:
+        signature << "private ";
+        break;
+    default:
+        break;
+    }
+    signature << "field\n";
+
+    auto fieldDecl = fieldDeclRef.getDecl();
+    printer.addDeclModifiers(fieldDecl, false);
+    if (as<LetDecl>(fieldDecl))
+        signature << "let ";
+    printer.addType(fieldType);
+    signature << " " << getText(fieldDeclRef.getName());
+    if ((fieldDecl->hasModifier<ConstModifier>() || as<LetDecl>(fieldDecl)) &&
+        fieldDecl->initExpr)
+    {
+        signature << " = ";
+        printer.addExpr(fieldDecl->initExpr);
+    }
+
+    signature << "\n    (in struct ";
+    printer.addDeclPath(structDeclRef);
+    signature << ")";
+    sb << printer.getString();
+    return true;
+}
