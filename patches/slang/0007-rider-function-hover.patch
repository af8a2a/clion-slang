@@ -514,6 +514,34 @@ static bool _tryAppendStructFieldHoverSignature(
     return true;
 }
 
+static bool _tryAppendFunctionHoverSignature(
+    StringBuilder& sb,
+    DeclRef<Decl> declRef,
+    ASTBuilder* astBuilder)
+{
+    auto funcDeclRef = declRef.as<FuncDecl>();
+    if (!funcDeclRef || !funcDeclRef.getName())
+        return false;
+
+    auto resultType = getResultType(astBuilder, funcDeclRef);
+    if (!resultType)
+        return false;
+
+    ASTPrinter printer(
+        astBuilder,
+        ASTPrinter::OptionFlag::ParamNames | ASTPrinter::OptionFlag::NoInternalKeywords |
+            ASTPrinter::OptionFlag::SimplifiedBuiltinType |
+            ASTPrinter::OptionFlag::DefaultParamValues |
+            ASTPrinter::OptionFlag::MultilineParamList);
+    printer.addDeclModifiers(funcDeclRef.getDecl());
+    printer.addType(resultType);
+    printer.getStringBuilder() << " ";
+    printer.addDeclPath(funcDeclRef);
+    printer.addDeclParams(funcDeclRef);
+    sb << printer.getString();
+    return true;
+}
