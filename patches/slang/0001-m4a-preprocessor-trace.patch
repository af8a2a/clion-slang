+static bool shouldRecordPreprocessorTrace(Preprocessor* preprocessor)
+{
+    return preprocessor->contentAssistInfo && preprocessor->m_currentInputFile &&
+           !preprocessor->m_currentInputFile->isIncludedFile();
+}
+
+static int getConditionalDepth(Conditional* conditional)
+{
+    int depth = 0;
+    for (auto parent = conditional ? conditional->parent : nullptr; parent; parent = parent->parent)
+        ++depth;
+    return depth;
+}
+
+static int getParentDirectiveIndex(Conditional* conditional)
+{
+    return conditional && conditional->parent ? conditional->parent->currentDirectiveIndex : -1;
+}
+
+static int addConditionalDirectiveForContentAssist(
+    PreprocessorDirectiveContext* context,
+    const char* kind,
+    bool evaluated,
+    bool value,
+    bool active,
+    int depth,
+    int parentDirective,
+    int matchingIfDirective,
+    int previousBranchDirective)
+{
+    auto preprocessor = context->m_preprocessor;
+    if (!shouldRecordPreprocessorTrace(preprocessor))
+        return -1;
+
+    ConditionalDirectiveContentAssistInfo info;
+    info.kind = kind;
+    info.beginLoc = context->m_beginLoc;
+    info.keywordLoc = context->m_directiveToken.loc;
+    info.keywordLength = (int)context->m_directiveToken.getContentLength();
+    info.evaluated = evaluated;
+    info.value = evaluated && value;
+    info.active = active;
+    info.depth = depth;
+    info.parentDirective = parentDirective;
+    info.matchingIfDirective = matchingIfDirective;
+    info.previousBranchDirective = previousBranchDirective;
+    auto index = (int)preprocessor->contentAssistInfo->conditionalDirectives.getCount();
+    preprocessor->contentAssistInfo->conditionalDirectives.add(_Move(info));
+    context->m_traceIndex = index;
+    return index;
+}
+
+static int getInactiveControllingDirective(InputFile* inputFile)
+{
+    for (auto conditional = inputFile->getInnerMostConditional(); conditional;
+         conditional = conditional->parent)
+    {
+        if (conditional->state != Conditional::State::During)
+            return conditional->currentDirectiveIndex;
+    }
+    return -1;
+}
+
+static void flushPendingInactiveRegion(
+    Preprocessor* preprocessor,
+    SourceLoc endLoc,
+    bool endsAtDirective = false)
+{
+    if (!preprocessor->hasPendingInactiveRegion)
+        return;
+
+    if (preprocessor->contentAssistInfo &&
+        endLoc.getRaw() > preprocessor->pendingInactiveBeginLoc.getRaw())
+    {
+        InactiveRegionContentAssistInfo info;
+        info.beginLoc = preprocessor->pendingInactiveBeginLoc;
+        info.endLoc = endLoc;
+        info.controllingDirective = preprocessor->pendingInactiveControllingDirective;
+        info.endsAtDirective = endsAtDirective;
+        preprocessor->contentAssistInfo->inactiveRegions.add(info);
+    }
+    preprocessor->hasPendingInactiveRegion = false;
+    preprocessor->pendingInactiveControllingDirective = -1;
+}
