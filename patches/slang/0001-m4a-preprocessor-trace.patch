+LanguageServerResult<LanguageServerProtocol::PreprocessorTrace>
+LanguageServerCore::preprocessorTrace(
+    const LanguageServerProtocol::PreprocessorTraceParams& args)
+{
+    String canonicalPath = uriToCanonicalPath(args.textDocument.uri);
+
+    RefPtr<DocumentVersion> doc;
+    if (!m_workspace->openedDocuments.tryGetValue(canonicalPath, doc))
+        return std::nullopt;
+
+    auto workspaceVersion = m_workspace->getCurrentVersion();
+    SLANG_AST_BUILDER_RAII(workspaceVersion->linkage->getASTBuilder());
+    if (!workspaceVersion->getOrLoadModule(canonicalPath))
+        return std::nullopt;
+
+    auto sourceManager = workspaceVersion->linkage->getSourceManager();
+    auto isPrimaryPath = [&](const HumaneSourceLoc& humaneLoc)
+    {
+        String locCanonicalPath;
+        if (SLANG_SUCCEEDED(
+                Path::getCanonical(humaneLoc.pathInfo.foundPath, locCanonicalPath)))
+            return locCanonicalPath == canonicalPath;
+        return humaneLoc.pathInfo.foundPath == canonicalPath;
+    };
+    auto getLineLength = [&](Index oneBasedLine)
+    {
+        auto boundaries = doc->getUTF16Boundaries(oneBasedLine);
+        return boundaries.getCount() ? (int)boundaries.getCount() - 1 : 0;
+    };
+    auto getDirectiveRanges = [&]
+    (
+        SourceLoc beginLoc,
+        SourceLoc endLoc,
+        SourceLoc loc,
+        int keywordLength,
+        LanguageServerProtocol::Range& range,
+        LanguageServerProtocol::Range& keywordRange
+    )
+    {
+        auto humaneLoc = sourceManager->getHumaneLoc(loc, SourceLocType::Actual);
+        auto beginHumane = sourceManager->getHumaneLoc(beginLoc, SourceLocType::Actual);
+        auto endHumane = sourceManager->getHumaneLoc(endLoc, SourceLocType::Actual);
+        if (!isPrimaryPath(humaneLoc) || !isPrimaryPath(beginHumane) ||
+            !isPrimaryPath(endHumane))
+            return false;
+
+        int32_t line = 0;
+        int32_t col = 0;
+        int32_t endLine = 0;
+        int32_t endCol = 0;
+        doc->oneBasedUTF8LocToZeroBasedUTF16Loc(humaneLoc.line, humaneLoc.column, line, col);
+        doc->oneBasedUTF8LocToZeroBasedUTF16Loc(
+            humaneLoc.line,
+            humaneLoc.column + keywordLength,
+            endLine,
+            endCol);
+        range.start.line = (int)beginHumane.line - 1;
+        range.start.character = 0;
+        Index finalLine = endHumane.line;
+        if (finalLine > beginHumane.line && endHumane.column == 1)
+            --finalLine;
+        range.end.line = (int)finalLine - 1;
+        range.end.character = getLineLength(finalLine);
+        keywordRange.start.line = line;
+        keywordRange.start.character = col;
+        keywordRange.end.line = endLine;
+        keywordRange.end.character = endCol;
+        return true;
+    };
+    auto getInactiveRange = [&]
+    (
+        SourceLoc beginLoc,
+        SourceLoc endLoc,
+        bool endsAtDirective,
+        LanguageServerProtocol::Range& range
+    )
+    {
+        auto beginHumane = sourceManager->getHumaneLoc(beginLoc, SourceLocType::Actual);
+        auto endHumane = sourceManager->getHumaneLoc(endLoc, SourceLocType::Actual);
+        if (!isPrimaryPath(beginHumane) || !isPrimaryPath(endHumane))
+            return false;
+
+        range.start.line = (int)beginHumane.line - 1;
+        range.start.character = 0;
+        range.end.line = (int)endHumane.line - 1;
+        range.end.character = endsAtDirective ? 0 : getLineLength(endHumane.line);
+        return range.start.line < range.end.line ||
+               (range.start.line == range.end.line &&
+                range.start.character < range.end.character);
+    };
+
+    PreprocessorTrace response;
+    response.uri = args.textDocument.uri;
+    response.version = doc->getVersion();
+
+    auto& traceInfo = workspaceVersion->linkage->contentAssistInfo.preprocessorInfo;
+    List<int> oldToNewDirectiveIndex;
+    oldToNewDirectiveIndex.setCount(traceInfo.conditionalDirectives.getCount());
+    for (auto& index : oldToNewDirectiveIndex)
+        index = -1;
+
+    for (Index oldIndex = 0; oldIndex < traceInfo.conditionalDirectives.getCount(); ++oldIndex)
+    {
+        auto& source = traceInfo.conditionalDirectives[oldIndex];
+        PreprocessorTraceDirective target;
+        if (!getDirectiveRanges(
+                source.beginLoc,
+                source.endLoc,
+                source.keywordLoc,
+                source.keywordLength,
+                target.range,
+                target.keywordRange))
+            continue;
+
+        target.kind = source.kind;
+        target.evaluated = source.evaluated;
+        target.value = source.value;
+        target.active = source.active;
+        target.depth = source.depth;
+        target.parentDirective = source.parentDirective;
+        target.matchingIfDirective = source.matchingIfDirective;
+        target.previousBranchDirective = source.previousBranchDirective;
+        oldToNewDirectiveIndex[oldIndex] = (int)response.directives.getCount();
+        response.directives.add(_Move(target));
+    }
+
+    auto remapDirectiveIndex = [&](int oldIndex)
+    {
+        if (oldIndex < 0 || oldIndex >= oldToNewDirectiveIndex.getCount())
+            return -1;
+        return oldToNewDirectiveIndex[oldIndex];
+    };
+    for (auto& directive : response.directives)
+    {
+        directive.parentDirective = remapDirectiveIndex(directive.parentDirective);
+        directive.matchingIfDirective = remapDirectiveIndex(directive.matchingIfDirective);
+        directive.previousBranchDirective =
+            remapDirectiveIndex(directive.previousBranchDirective);
+    }
+
+    for (auto& source : traceInfo.inactiveRegions)
+    {
+        PreprocessorTraceInactiveRegion target;
+        if (!getInactiveRange(source.beginLoc, source.endLoc, source.endsAtDirective, target.range))
+            continue;
+        target.controllingDirective = remapDirectiveIndex(source.controllingDirective);
+        response.inactiveRegions.add(_Move(target));
+    }
+    return response;
+}
