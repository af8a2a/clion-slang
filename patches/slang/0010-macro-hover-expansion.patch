+
+// Called only for final tokens emitted to the parser, never intermediate argument expansion.
+void ExpansionInputStream::recordHoverToken(const Token& token)
+{
+    if (!m_preprocessor->contentAssistInfo || token.type == TokenType::EndOfFile ||
+        token.type == TokenType::NewLine || token.type == TokenType::WhiteSpace)
+        return;
+    auto append = [&](Index index)
+    {
+        auto& info = m_preprocessor->contentAssistInfo->macroInvocations[index];
+        info.hasExpansionPreview = true;
+        if (info.expandedTokens.getCount() < 512)
+            info.expandedTokens.add(token);
+        else
+            info.expansionTruncated = true;
+    };
+    auto stream = m_inputStreams.getTopStream();
+    auto busy = stream->getFirstBusyMacroInvocation();
+    Index rootIndex = -1;
+    // Function-like rescan may drop the initiating macro from the busy chain
+    // (e.g. SUM(...) -> ADD(__VA_ARGS__)); retain the original call's preview.
+    if (busy && m_preprocessor->hoverInvocationIndices.tryGetValue(
+                    m_initiatingMacroInvocationLoc.getRaw(), rootIndex))
+        append(rootIndex);
+    for (auto invocation = busy; invocation;
+         invocation = invocation->getNextBusyMacroInvocation())
+    {
+        if (invocation->hoverInfoIndex >= 0 && invocation->hoverInfoIndex != rootIndex)
+            append(invocation->hoverInfoIndex);
+    }
 }
 
