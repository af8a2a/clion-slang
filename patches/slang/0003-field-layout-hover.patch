+struct FieldLayoutInfo
+{
+    Count size = 0;
+    Count alignment = 0;
+    Count offset = 0;
+};
+
+static bool _tryGetFieldLayoutInfo(
+    DeclRef<Decl> declRef,
+    ASTBuilder* astBuilder,
+    FieldLayoutInfo& outInfo)
+{
+    auto fieldDeclRef = declRef.as<VarDecl>();
+    if (!fieldDeclRef)
+        return false;
+
+    auto parentDeclRef = fieldDeclRef.getParent();
+    if (auto genericDeclRef = parentDeclRef.as<GenericDecl>())
+        parentDeclRef = genericDeclRef.getParent();
+    auto structDeclRef = parentDeclRef.as<StructDecl>();
+    if (!structDeclRef)
+        return false;
+
+    ASTNaturalLayoutContext layoutContext(astBuilder);
+    NaturalSize aggregateSize = NaturalSize::makeEmpty();
+
+    if (auto inheritedType = findBaseStructType(astBuilder, structDeclRef))
+    {
+        aggregateSize = layoutContext.calcSize(inheritedType);
+        if (!aggregateSize)
+            return false;
+    }
+
+    for (auto currentFieldDeclRef :
+         getFields(astBuilder, structDeclRef, MemberFilterStyle::Instance))
+    {
+        auto fieldType = getType(astBuilder, currentFieldDeclRef);
+        auto fieldSize = layoutContext.calcSize(fieldType);
+        if (!fieldSize)
+            return false;
+
+        Count fieldOffset = NaturalSize::calcAligned(aggregateSize.size, fieldSize.alignment);
+        if (currentFieldDeclRef.getDecl() == fieldDeclRef.getDecl())
+        {
+            outInfo.size = fieldSize.size;
+            outInfo.alignment = fieldSize.alignment;
+            outInfo.offset = fieldOffset;
+            return true;
+        }
+        aggregateSize.append(fieldSize);
+    }
+    return false;
+}
+
+static void _appendFieldLayoutInfo(
+    StringBuilder& sb,
+    DeclRef<Decl> declRef,
+    ASTBuilder* astBuilder)
+{
+    FieldLayoutInfo info;
+    if (!_tryGetFieldLayoutInfo(declRef, astBuilder, info))
+        return;
+
+    sb << "\n**Natural layout**  \n";
+    sb << "Size: " << info.size << " bytes  \n";
+    sb << "Alignment: " << info.alignment << " bytes  \n";
+    sb << "Offset: " << info.offset << " bytes\n\n";
+}
