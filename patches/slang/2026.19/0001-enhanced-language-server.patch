+    auto signature = getDeclSignatureString(declRef, version);
+    if (signature.startsWith(signaturePrefix.getUnownedSlice()))
+        sb << signature.getUnownedSlice().tail(signaturePrefix.getLength());
+    sb << "\n```\n\n";
+    ASTPrinter ownerPrinter(astBuilder);
+    ownerPrinter.addDeclPath(owner);
+    sb << "(in struct `" << ownerPrinter.getString() << "`)\n\n";
+
+    HoverNaturalLayout context{astBuilder};
+    auto layout = context.calc(type);
+    sb << "**Natural field layout (bytes)**  \nSize: ";
+    if (layout.size)
+        sb << "`" << layout.size.size << "`  \nAlignment: `" << layout.size.alignment << "`";
+    else
+        sb << "unavailable  \nAlignment: unavailable";
+    sb << "  \nOffset: ";
