+        {
+            auto ownerFile = implementingDecl->fileDecl;
+            if (ownerFile && as<ModuleDeclarationDecl>(ownerFile->getFirstDirectMemberDecl()))
+            {
+                // The implementing file is the synthetic primary module in the language server.
+                // Restore its owner's using directives in an outer lexical scope, preserving
+                // the precedence of the implementing file's own using directives.
+                auto inheritedScope = getASTBuilder()->create<Scope>();
