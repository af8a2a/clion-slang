+static void appendStructDefinitionLocation(StringBuilder& sb, const HumaneSourceLoc& loc)
+{
+    auto path = loc.pathInfo.foundPath;
+    if (path.getLength() == 0)
+        return;
+    Path::getCanonical(path, path);
+    auto name = Path::getFileName(path);
+    sb << "\n---\n\n[";
+    for (auto c : name)
+    {
+        if (c == '[' || c == ']' || c == '\\' || c == '`' || c == '*' || c == '_' || c == '<' ||
+            c == '>')
+            sb << '\\';
+        sb << c;
+    }
+    sb << ":" << loc.line << "](<file://";
+#if SLANG_WINDOWS_FAMILY
+    if (!path.startsWith("\\\\") && !path.startsWith("//"))
+        sb << "/";
+    else
+        path = path.getUnownedSlice().tail(2);
+#endif
+    // Encode unsigned UTF-8 bytes, including Markdown delimiters. Keep the drive
+    // colon intact so IDE file-URL handlers can resolve Windows paths directly.
+    const char* hex = "0123456789ABCDEF";
+    for (auto c : path)
+    {
+        if (URI::isSafeURIChar(c) || c == ':')
+            sb << c;
+        else if (c == '\\')
+            sb << '/';
+        else
+        {
+            auto byte = uint8_t(c);
+            sb << '%' << hex[byte >> 4] << hex[byte & 15];
+        }
+    }
+    sb << "#L" << loc.line << ">)\n";
+}
