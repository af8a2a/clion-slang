+// Request-local natural layout, following slang-ast-natural-layout. Keep substituted
+// fields and instance filtering here: hover must also work for generic structs and
+// must not count static storage. This does not change compiler sizeof/ABI behavior.
+struct HoverNaturalLayout
+{
+    struct Info
+    {
+        NaturalSize size = NaturalSize::makeInvalid();
+        Count payload = 0; // Bytes occupied by leaves, excluding nested padding.
+    };
+
+    ASTBuilder* astBuilder;
+    Dictionary<Type*, Info> cache;
+    Count remaining = 4096;
+    static constexpr Count maxSize = (std::numeric_limits<Count>::max)();
+
+    bool append(Info& result, const Info& field)
+    {
+        if (!field.size || result.size.size > maxSize - (field.size.alignment - 1))
+            return false;
+        auto offset = NaturalSize::calcAligned(result.size.size, field.size.alignment);
+        if (field.size.size > maxSize - offset)
+            return false;
+        result.size.append(field.size);
+        result.payload += field.payload;
+        return true;
+    }
+
+    Info repeat(const Info& element, IntVal* countVal)
+    {
+        auto count = as<ConstantIntVal>(countVal);
+        if (!element.size || !count || count->getValue() <= 0 || count->getValue() > maxSize ||
+            element.size.size > maxSize - (element.size.alignment - 1))
+            return {};
+        auto n = Count(count->getValue());
+        auto stride = element.size.getStride();
+        if (stride && n - 1 > (maxSize - element.size.size) / stride)
+            return {};
+        return {element.size * n, element.payload * n};
+    }
+
+    Info calc(Type* type, Index depth = 0)
+    {
+        if (!type || depth >= 64 || --remaining < 0)
+            return {};
+        if (auto found = cache.tryGetValue(type))
+            return *found;
+        // Poison before descending so incomplete/recursive source cannot loop.
+        cache.add(type, Info{});
+        auto result = calcImpl(type, depth + 1);
+        cache.set(type, result);
+        return result;
+    }
+
+    Info calcImpl(Type* type, Index depth)
+    {
+        if (auto named = as<NamedExpressionType>(type))
+            return calc(named->getCanonicalType(), depth);
+        if (auto vector = as<VectorExpressionType>(type))
+            return repeat(calc(vector->getElementType(), depth), vector->getElementCount());
+        if (auto matrix = as<MatrixExpressionType>(type))
+            return repeat(
+                repeat(calc(matrix->getElementType(), depth), matrix->getColumnCount()),
+                matrix->getRowCount());
+        if (auto array = as<ArrayExpressionType>(type))
+        {
+            if (array->isUnsized())
+                return {};
+            return repeat(calc(array->getElementType(), depth), array->getElementCount());
+        }
+        if (auto atomic = as<AtomicType>(type))
+            return calc(atomic->getElementType(), depth);
+        if (as<BasicExpressionType>(type) || as<BFloat16Type>(type) || as<Fp8Type>(type))
+        {
+            ASTNaturalLayoutContext context(astBuilder);
+            auto size = context.calcSize(type);
+            return {size, size.size};
+        }
+        // Builtin resource/pointer types also derive from DeclRefType, but their
+        // empty intrinsic declarations do not describe zero-byte user structs.
+        if (as<BuiltinType>(type))
+            return {};
+        if (auto refType = as<DeclRefType>(type))
+        {
+            auto declRef = refType->getDeclRef();
+            if (auto enumRef = declRef.as<EnumDecl>())
+                return calc(getTagType(astBuilder, enumRef), depth);
+            if (auto alias = declRef.as<TypeDefDecl>())
+                return calc(getType(astBuilder, alias), depth);
+            if (auto structRef = declRef.as<StructDecl>())
