+{
+    auto expr = as<VarExpr>(node);
+    if (!expr || !expr->declRef || !expr->name) return false;
+    auto name = getText(expr->name);
+    if (name != "ResourceDescriptorHeap" && name != "SamplerDescriptorHeap") return false;
+    auto decl = expr->declRef.getDecl();
+    if (!as<VarDeclBase>(decl) || !as<ModuleDecl>(decl->parentDecl)) return false;
+    auto origin = manager->getHumaneLoc(decl->loc, SourceLocType::Actual).pathInfo;
+    return origin.getName() == "core" && !File::exists(origin.foundPath);
+}
