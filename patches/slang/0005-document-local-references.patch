+SlangResult LanguageServer::findReferences(
+    const LanguageServerProtocol::ReferenceParams& args,
+    const JSONValue& responseId)
+{
+    auto result = m_core.findReferences(args);
+    removePendingModuleToUpdateDiagnostics(args.textDocument.uri);
+
+    if (SLANG_FAILED(result.returnCode) || result.isNull)
+    {
+        m_connection->sendResult(NullResponse::get(), responseId);
+        return SLANG_OK;
+    }
+    m_connection->sendResult(&result.result, responseId);
+    return SLANG_OK;
+}
+
+LanguageServerResult<List<LanguageServerProtocol::Location>> LanguageServerCore::findReferences(
+    const LanguageServerProtocol::ReferenceParams& args)
+{
+    String canonicalPath = uriToCanonicalPath(args.textDocument.uri);
+    RefPtr<DocumentVersion> doc;
+    if (!m_workspace->openedDocuments.tryGetValue(canonicalPath, doc))
+    {
+        return std::nullopt;
+    }
+
+    Index line, col;
+    doc->zeroBasedUTF16LocToOneBasedUTF8Loc(args.position.line, args.position.character, line, col);
+
+    auto version = m_workspace->getCurrentVersion();
+    SLANG_AST_BUILDER_RAII(version->linkage->getASTBuilder());
+
+    Module* parsedModule = version->getOrLoadModule(canonicalPath);
+    if (!parsedModule)
+    {
+        return std::nullopt;
+    }
+
+    auto sourceManager = version->linkage->getSourceManager();
+    auto findResult = findASTNodesAt(
+        doc.Ptr(),
+        sourceManager,
+        parsedModule->getModuleDecl(),
+        ASTLookupType::Decl,
+        canonicalPath.getUnownedSlice(),
+        line,
+        col);
+    if (findResult.getCount() == 0 || findResult[0].path.getCount() == 0)
+    {
+        return std::nullopt;
+    }
+
+    Decl* targetDecl = nullptr;
+    auto leafNode = findResult[0].path.getLast();
+    if (auto declRefExpr = as<DeclRefExpr>(leafNode))
+    {
+        targetDecl = declRefExpr->declRef.getDecl();
+    }
+    else if (auto decl = as<Decl>(leafNode))
+    {
+        targetDecl = decl;
+    }
+
+    if (!as<VarDeclBase>(targetDecl) || !targetDecl->getName() ||
+        targetDecl->findModifier<SynthesizedModifier>() ||
+        targetDecl->findModifier<ImplicitParameterGroupElementTypeModifier>())
+    {
+        return std::nullopt;
+    }
+
+    List<Location> results;
+    auto appendLocation = [&](SourceLoc sourceLoc, Name* name)
+    {
+        if (!name)
+            return;
+
+        auto humaneLoc = sourceManager->getHumaneLoc(sourceLoc, SourceLocType::Actual);
+        if (!humaneLoc.pathInfo.hasFoundPath() ||
+            !humaneLoc.pathInfo.foundPath.getUnownedSlice().endsWithCaseInsensitive(
+                canonicalPath.getUnownedSlice()))
+        {
+            return;
+        }
+
+        Location location;
+        location.uri = URI::fromLocalFilePath(canonicalPath.getUnownedSlice()).uri;
+        doc->oneBasedUTF8LocToZeroBasedUTF16Loc(
+            humaneLoc.line,
+            humaneLoc.column,
+            location.range.start.line,
+            location.range.start.character);
+        location.range.end = location.range.start;
+        location.range.end.character +=
+            (int)UTF8Util::calcUTF16CharCount(name->text.getUnownedSlice());
+
+        for (const auto& existing : results)
+        {
+            if (existing.range.start.line == location.range.start.line &&
+                existing.range.start.character == location.range.start.character &&
+                existing.range.end.line == location.range.end.line &&
+                existing.range.end.character == location.range.end.character)
+            {
+                return;
+            }
+        }
+        results.add(_Move(location));
+    };
+
+    iterateASTWithLanguageServerFilter(
+        canonicalPath.getUnownedSlice(),
+        sourceManager,
+        parsedModule->getModuleDecl(),
+        [&](SyntaxNode* node)
+        {
+            if (args.context.includeDeclaration && node == targetDecl)
+            {
+                appendLocation(targetDecl->getNameLoc(), targetDecl->getName());
+            }
+            else if (auto declRefExpr = as<DeclRefExpr>(node))
+            {
+                if (declRefExpr->declRef.getDecl() == targetDecl)
+                {
+                    auto name = declRefExpr->name;
+                    if (!name)
+                        name = declRefExpr->declRef.getName();
+                    appendLocation(declRefExpr->loc, name);
+                }
+            }
+        });
+
+    std::sort(
+        results.begin(),
+        results.end(),
+        [](const Location& left, const Location& right)
+        {
+            if (left.range.start.line != right.range.start.line)
+                return left.range.start.line < right.range.start.line;
+            return left.range.start.character < right.range.start.character;
+        });
+
+    return results;
+}
