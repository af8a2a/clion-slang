+SlangResult LanguageServer::documentHighlight(
+    const LanguageServerProtocol::DocumentHighlightParams& args,
+    const JSONValue& responseId)
+{
+    auto result = m_core.documentHighlight(args);
+    removePendingModuleToUpdateDiagnostics(args.textDocument.uri);
+
+    if (SLANG_FAILED(result.returnCode) || result.isNull)
+    {
+        m_connection->sendResult(NullResponse::get(), responseId);
+        return SLANG_OK;
+    }
+    m_connection->sendResult(&result.result, responseId);
+    return SLANG_OK;
+}
+
+LanguageServerResult<List<LanguageServerProtocol::DocumentHighlight>>
+LanguageServerCore::documentHighlight(
+    const LanguageServerProtocol::DocumentHighlightParams& args)
+{
+    ReferenceParams referenceArgs;
+    referenceArgs.workDoneToken = args.workDoneToken;
+    referenceArgs.textDocument = args.textDocument;
+    referenceArgs.position = args.position;
+    referenceArgs.context.includeDeclaration = true;
+
+    auto references = findReferences(referenceArgs);
+    if (SLANG_FAILED(references.returnCode))
+    {
+        return references.returnCode;
+    }
+    if (references.isNull)
+    {
+        return std::nullopt;
+    }
+
+    List<DocumentHighlight> highlights;
+    for (const auto& reference : references.result)
+    {
+        DocumentHighlight highlight;
+        highlight.range = reference.range;
+        highlight.kind = kDocumentHighlightKindText;
+        highlights.add(_Move(highlight));
+    }
+    return highlights;
+}
