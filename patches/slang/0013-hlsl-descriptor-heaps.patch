+// Editor fallback for HLSL globals absent from Slang's core module. Checked
+// user declarations (including shadowing) always take precedence. MemberExpr,
+// comments, strings and inactive preprocessor branches cannot match this test.
+inline bool isHlslDescriptorHeapReference(SyntaxNode* node)
+{
+    auto expr = as<VarExpr>(node);
+    if (!expr || expr->declRef || !expr->name) return false;
+    auto name = getText(expr->name);
+    return name == "ResourceDescriptorHeap" || name == "SamplerDescriptorHeap";
+}
