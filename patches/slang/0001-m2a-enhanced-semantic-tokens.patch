+        _addModifier(token, SemanticTokenModifier::Readonly);
+    if (decl->hasModifier<HLSLStaticModifier>())
+        _addModifier(token, SemanticTokenModifier::Static);
+    if (_isDefaultLibraryDecl(linkage, decl))
+        _addModifier(token, SemanticTokenModifier::DefaultLibrary);
+}
+
+static void _addDeclarationKind(SemanticToken& token, Decl* decl)
+{
+    if (auto aggTypeDecl = as<AggTypeDecl>(decl))
+    {
+        _addModifier(
+            token,
+            aggTypeDecl->hasBody ? SemanticTokenModifier::Definition
+                                 : SemanticTokenModifier::Declaration);
+    }
+    else if (auto functionDecl = as<FunctionDeclBase>(decl))
+    {
+        _addModifier(
+            token,
+            functionDecl->body ? SemanticTokenModifier::Definition
+                               : SemanticTokenModifier::Declaration);
+    }
+    else
+    {
+        _addModifier(token, SemanticTokenModifier::Declaration);
+    }
+}
