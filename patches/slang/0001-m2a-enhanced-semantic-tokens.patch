+static SemanticTokenType _classifyTypeDecl(Linkage* linkage, Decl* decl)
+{
+    if (_isDefaultLibraryDecl(linkage, decl))
+        return SemanticTokenType::Type;
+    if (as<ClassDecl>(decl))
+        return SemanticTokenType::Class;
+    if (as<StructDecl>(decl))
+        return SemanticTokenType::Struct;
+    if (as<InterfaceDecl>(decl))
+        return SemanticTokenType::Interface;
+    if (as<EnumDecl>(decl))
+        return SemanticTokenType::Enum;
+    if (as<GenericTypeParamDeclBase>(decl))
+        return SemanticTokenType::TypeParameter;
+    return SemanticTokenType::Type;
+}
+
+static SemanticTokenType _classifyDecl(Linkage* linkage, Decl* decl)
+{
+    if (as<GenericTypeParamDeclBase>(decl) || as<AggTypeDecl>(decl) || as<SimpleTypeDecl>(decl))
+        return _classifyTypeDecl(linkage, decl);
+    if (as<ConstructorDecl>(decl))
+        return SemanticTokenType::Type;
+    if (as<PropertyDecl>(decl))
+        return SemanticTokenType::Property;
+    if (as<ParamDecl>(decl))
+        return SemanticTokenType::Parameter;
+    if (as<VarDeclBase>(decl))
+        return _isAggregateMember(decl) ? SemanticTokenType::Property : SemanticTokenType::Variable;
+    if (as<FunctionDeclBase>(decl))
+        return _isAggregateMember(decl) ? SemanticTokenType::Method : SemanticTokenType::Function;
+    if (as<EnumCaseDecl>(decl))
+        return SemanticTokenType::EnumMember;
+    if (as<NamespaceDecl>(decl))
+        return SemanticTokenType::Namespace;
+    return SemanticTokenType::NormalText;
